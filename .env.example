# MySQL connection string
DATABASE_URL="mysql://user:password@localhost:3306/ncdc_conference"

# Session signing secret (min 32 characters)
SESSION_SECRET="change-this-to-a-long-random-secret-in-production"

NEXT_PUBLIC_TINYMCE_API_KEY=your_tinymce_api_key_here

# Public site URL (email links, access-code CTAs, certificate QR codes)
# Production example: https://conference.mubs.ac.ug
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Post-deploy super admin seed (npm run db:seed / seed:superadmin)
SEED_SUPERADMIN_EMAIL="admin@ncdc.go.ug"
SEED_SUPERADMIN_PASSWORD="ChangeMe123!"
SEED_SUPERADMIN_NAME="NCDC Super Admin"
# Set to true only when you intentionally want to reset an existing admin password
# SEED_SUPERADMIN_RESET_PASSWORD=true

# SMTP (nodemailer) — registration and password emails
#
# Gmail (personal):
#   1. Enable 2-Step Verification on the Google account
#   2. Create an App Password: https://myaccount.google.com/apppasswords
#   3. Use that 16-character password as SMTP_PASS (not your normal Gmail password)
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=xxxx xxxx xxxx xxxx
#   SMTP_FROM="NCDC Conference <you@gmail.com>"
#
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="you@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM="NCDC Conference <you@gmail.com>"

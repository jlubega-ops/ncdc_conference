generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  CONFERENCE_ADMIN
  REVIEWER
  ATTENDEE
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
}

enum ConferenceLifecycleStatus {
  cfp_open
  registration_open
  running
  submissions_closed
  upcoming
  completed
}

enum RegistrationStatus {
  PENDING
  NEEDS_REVISION
  CONFIRMED
  CANCELLED
}

enum PaperSubmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  NEEDS_REVISION
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum ConferenceResourceType {
  MATERIAL
  PAPER_TEMPLATE
  PRESENTATION_TEMPLATE
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String?
  mustChangePassword Boolean   @default(false)
  passwordResetToken String?   @unique
  passwordResetExpires DateTime?
  name               String?
  image              String?
  profileData        Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  roles                UserRole[]
  sessions             Session[]
  conferenceAccessKeys ConferenceAccessKey[]
  conferencesCreated   Conference[]             @relation("ConferenceCreator")
  registrations        ConferenceRegistration[]
  attendanceMarks      ConferenceAttendance[]
  paperSubmissions       PaperSubmission[]
  papersAssignedReview   PaperSubmission[]      @relation("PaperAssignedReviewer")
  conferenceFeedback     ConferenceFeedback[]
  certificates           ConferenceCertificate[]

  @@map("users")
}

model UserRole {
  id           String   @id @default(cuid())
  userId       String
  role         Role
  conferenceId String?
  createdAt    DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  conference Conference? @relation(fields: [conferenceId], references: [id], onDelete: Cascade)

  @@unique([userId, role, conferenceId])
  @@index([userId])
  @@map("user_roles")
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  activeRole Role
  userAgent  String?  @db.Text
  ipAddress  String?  @db.VarChar(45)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Conference {
  id                   String                    @id @default(cuid())
  slug                 String                    @unique
  title                String
  shortDescription     String?                   @db.Text
  description          String?                   @db.Text
  theme                String?                   @db.Text
  subThemes            Json?
  startDate            DateTime?
  endDate              DateTime?
  location             String?
  venue                String?                   @db.Text
  category             String?
  lifecycleStatus      ConferenceLifecycleStatus @default(upcoming)
  publicationStatus    PublicationStatus         @default(DRAFT)
  featured             Boolean                   @default(false)
  cardImage            String?
  cfpOpenAt            DateTime?
  cfpCloseAt           DateTime?
  registrationOpenAt   DateTime?
  registrationCloseAt  DateTime?
  conferenceDays       Json?
  timezone             String?                   @default("Africa/Nairobi")
  cfpTopics            Json?
  submissionGuidelines String?                   @db.Text
  programme            Json?
  speakers             Json?
  faqs                 Json?
  requiresPayment      Boolean                   @default(false)
  paymentDetails       Json?
  paidContentVisibility Json?
  onlineStream         Json?
  contacts             Json?
  publishedAt          DateTime?
  createdById          String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  createdBy      User?                    @relation("ConferenceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  roles          UserRole[]
  accessKeys     ConferenceAccessKey[]
  registrations  ConferenceRegistration[]
  attendance     ConferenceAttendance[]
  submissions    PaperSubmission[]
  feedback       ConferenceFeedback[]
  resources      ConferenceResource[]
  presentations  ConferencePresentation[]
  certificates   ConferenceCertificate[]

  @@index([publicationStatus])
  @@index([featured])
  @@index([startDate])
  @@map("conferences")
}

model ConferenceAccessKey {
  id             String    @id @default(cuid())
  conferenceId   String
  userId         String?
  email          String
  keyHash        String
  keySuffix      String?
  conferenceYear Int?
  label          String?
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  conference Conference @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([conferenceId, email])
  @@index([email, conferenceYear])
  @@map("conference_access_keys")
}

model ConferenceRegistration {
  id                 String             @id @default(cuid())
  conferenceId       String
  userId             String
  status             RegistrationStatus @default(PENDING)
  paymentStatus      String?
  paymentProofFileId String?
  formData           Json?
  adminNotes         String?            @db.Text
  improvementRequest String?            @db.Text
  reviewedAt         DateTime?
  reviewedById       String?
  registeredAt       DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  conference Conference @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conferenceId, userId])
  @@index([conferenceId])
  @@map("conference_registrations")
}

model ConferenceAttendance {
  id           String   @id @default(cuid())
  conferenceId String
  userId       String
  dayDate      String   @db.VarChar(10)
  dayIndex     Int      @default(1)
  markedAt     DateTime @default(now())

  conference Conference @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conferenceId, userId, dayDate])
  @@index([conferenceId, dayDate])
  @@index([userId])
  @@map("conference_attendance")
}

model ConferenceCertificate {
  id                String   @id @default(cuid())
  certificateNumber String   @unique @db.VarChar(64)
  conferenceId      String
  userId            String
  recipientName     String
  attendancePercent Int
  daysAttended      Int
  totalDays         Int
  issuedAt          DateTime @default(now())
  emailedAt         DateTime?

  conference Conference @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conferenceId, userId])
  @@index([certificateNumber])
  @@map("conference_certificates")
}

model PaperSubmission {
  id                      String                @id @default(cuid())
  conferenceId            String
  userId                  String
  title                   String
  abstract                String?               @db.Text
  fileUrl                 String?
  fileId                  String?
  status                  PaperSubmissionStatus @default(DRAFT)
  improvementRequest      String?               @db.Text
  reviewNotes             String?               @db.Text
  reviewedAt              DateTime?
  reviewedById            String?
  assignedReviewerId      String?
  authorHasUnreadFeedback Boolean               @default(false)
  isFinalApproved         Boolean               @default(false)
  activityLog             Json?
  submittedAt             DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  conference       Conference @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedReviewer User?      @relation("PaperAssignedReviewer", fields: [assignedReviewerId], references: [id], onDelete: SetNull)

  @@index([conferenceId])
  @@index([userId])
  @@index([assignedReviewerId])
  @@map("paper_submissions")
}

model ConferenceFeedback {
  id           String   @id @default(cuid())
  conferenceId String
  userId       String
  rating       Int?
  comment      String   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  conference Conference @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conferenceId])
  @@map("conference_feedback")
}

model ConferenceResource {
  id           String                 @id @default(cuid())
  conferenceId String
  type         ConferenceResourceType
  title        String
  description  String?                @db.Text
  fileId       String
  fileName     String?
  sortOrder    Int                    @default(0)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  conference Conference @relation(fields: [conferenceId], references: [id], onDelete: Cascade)

  @@index([conferenceId, type])
  @@map("conference_resources")
}

model ConferencePresentation {
  id           String   @id @default(cuid())
  conferenceId String
  title        String
  speakerName  String?
  speakerTitle String?
  sessionLabel String?
  description  String?  @db.Text
  fileId       String?
  fileName     String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  conference Conference @relation(fields: [conferenceId], references: [id], onDelete: Cascade)

  @@index([conferenceId])
  @@map("conference_presentations")
}

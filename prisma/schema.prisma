generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  CONFERENCE_ADMIN
  REVIEWER
  ATTENDEE
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
}

enum ConferenceLifecycleStatus {
  cfp_open
  registration_open
  running
  submissions_closed
  upcoming
  completed
}

enum RegistrationStatus {
  PENDING
  NEEDS_REVISION
  CONFIRMED
  CANCELLED
}

enum ConferenceRegistrationMode {
  AUTO_APPROVE
  MANUAL_APPROVE
  OPEN_NO_REGISTRATION
  ADMIN_UPLOAD
}

enum PaperSubmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  NEEDS_REVISION
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum ConferenceResourceType {
  MATERIAL
  PAPER_TEMPLATE
  PRESENTATION_TEMPLATE
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String?
  mustChangePassword Boolean   @default(false)
  /// Plaintext default password while mustChangePassword is true. Cleared after the user sets their own password.
  temporaryPassword  String?   @db.VarChar(64)
  passwordResetToken String?   @unique
  passwordResetExpires DateTime?
  name               String?
  image              String?
  profileData        Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  roles                UserRole[]
  sessions             Session[]
  conferenceAccessKeys ConferenceAccessKey[]
  conferencesCreated   Conference[]             @relation("ConferenceCreator")
  registrations        ConferenceRegistration[]
  registrationsCreated ConferenceRegistration[] @relation("RegistrationCreatedBy")
  attendanceMarks      ConferenceAttendance[]
  attendanceMarked     ConferenceAttendance[]   @relation("AttendanceMarkedBy")
  paperSubmissions       PaperSubmission[]
  papersAssignedReview   PaperSubmission[]      @relation("PaperAssignedReviewer")
  conferenceFeedback     ConferenceFeedback[]
  certificates           ConferenceCertificate[]
  giftIssuances          ConferenceGiftIssuance[] @relation("GiftRecipient")
  giftsIssued            ConferenceGiftIssuance[] @relation("GiftIssuedBy")
  tourRegistrations      ConferenceTourRegistration[] @relation("TourRegistrant")
  toursRegistered        ConferenceTourRegistration[] @relation("TourRegisteredBy")
  representedAsPrincipal ConferenceRepresentative[] @relation("RepresentedPrincipals")
  actingAsRepresentative ConferenceRepresentative[] @relation("ActingRepresentatives")

  @@map("users")
}

model UserRole {
  id           String   @id @default(cuid())
  userId       String
  role         Role
  conferenceId String?
  createdAt    DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  conference Conference? @relation(fields: [conferenceId], references: [id], onDelete: Cascade)

  @@unique([userId, role, conferenceId])
  @@index([userId])
  @@index([conferenceId, role])
  @@map("user_roles")
}

model Session {
  id                  String   @id @default(cuid())
  userId              String
  tokenHash           String   @unique
  activeRole          Role
  activeConferenceId  String?
  userAgent           String?  @db.Text
  ipAddress           String?  @db.VarChar(45)
  expiresAt           DateTime
  createdAt           DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Conference {
  id                   String                    @id @default(cuid())
  slug                 String                    @unique
  reference            String?                   @unique @db.VarChar(48)
  registrationMode     ConferenceRegistrationMode @default(MANUAL_APPROVE)
  title                String
  shortDescription     String?                   @db.Text
  description          String?                   @db.Text
  organiserName        String?                   @db.VarChar(200)
  organiserShortName   String?                   @db.VarChar(16)
  organiserLogo        String?
  theme                String?                   @db.Text
  subThemes            Json?
  startDate            DateTime?
  endDate              DateTime?
  location             String?
  venue                String?                   @db.Text
  category             String?
  lifecycleStatus      ConferenceLifecycleStatus @default(upcoming)
  publicationStatus    PublicationStatus         @default(DRAFT)
  featured             Boolean                   @default(false)
  cardImage            String?
  allowPaperSubmissions Boolean                  @default(false)
  cfpOpenAt            DateTime?
  cfpCloseAt           DateTime?
  registrationOpenAt   DateTime?
  registrationCloseAt  DateTime?
  conferenceDays       Json?
  timezone             String?                   @default("Africa/Nairobi")
  cfpTopics            Json?
  submissionGuidelines String?                   @db.Text
  programme            Json?
  speakers             Json?
  faqs                 Json?
  /// Day questions + which speaker roles to evaluate + allowed / availability
  feedbackSettings     Json?
  /// Attendance feature: { allowed }
  attendanceSettings   Json?
  /// Certificates: { allowed, basedOnAttendance, minAttendanceDays, downloadOpensAt }
  certificateSettings  Json?
  /// Awards & gifts: applicable flag, items, recipient categories
  giftsSettings        Json?
  /// Extra registrations: { tour: { allowed } }
  tourSettings         Json?
  requiresPayment      Boolean                   @default(false)
  paymentDetails       Json?
  paidContentVisibility Json?
  onlineStream         Json?
  /// { allowed: boolean, rooms: [{ id, platform, topic, link, description }] }
  breakoutRooms        Json?
  contacts             Json?
  publishedAt          DateTime?
  createdById          String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  createdBy      User?                    @relation("ConferenceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  roles          UserRole[]
  accessKeys     ConferenceAccessKey[]
  registrations  ConferenceRegistration[]
  representatives ConferenceRepresentative[]
  attendance     ConferenceAttendance[]
  submissions    PaperSubmission[]
  feedback       ConferenceFeedback[]
  resources      ConferenceResource[]
  presentations  ConferencePresentation[]
  certificates   ConferenceCertificate[]
  giftIssuances  ConferenceGiftIssuance[]
  tourRegistrations ConferenceTourRegistration[]

  @@index([publicationStatus])
  @@index([featured])
  @@index([startDate])
  @@index([updatedAt])
  @@map("conferences")
}

model ConferenceAccessKey {
  id             String    @id @default(cuid())
  conferenceId   String
  userId         String?
  email          String
  keyHash        String
  /// Short memorable code (admin-visible). Globally unique across the platform.
  displayCode    String?   @unique @db.VarChar(16)
  keySuffix      String?
  conferenceYear Int?
  label          String?
  expiresAt      DateTime?
  revokedAt      DateTime?
  /// Last successful sign-in with this access code
  lastUsedAt     DateTime?
  /// When the access code was emailed to the attendee (null = not sent yet)
  emailedAt      DateTime?
  createdAt      DateTime  @default(now())

  conference Conference @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([conferenceId, email])
  @@index([conferenceId, userId])
  @@index([email, conferenceYear])
  @@index([displayCode])
  @@map("conference_access_keys")
}

model ConferenceRegistration {
  id                 String             @id @default(cuid())
  conferenceId       String
  userId             String
  status             RegistrationStatus @default(PENDING)
  paymentStatus      String?
  paymentProofFileId String?
  formData           Json?
  adminNotes         String?            @db.Text
  improvementRequest String?            @db.Text
  reviewedAt         DateTime?
  reviewedById       String?
  /// SELF | ADMIN | UPLOAD
  registeredBySource String?            @db.VarChar(16)
  registeredById     String?
  registeredAt       DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  conference Conference @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  registeredBy User?    @relation("RegistrationCreatedBy", fields: [registeredById], references: [id], onDelete: SetNull)
  representatives      ConferenceRepresentative[] @relation("PrincipalReps")
  representingFor      ConferenceRepresentative[] @relation("AsRepresentative")

  @@unique([conferenceId, userId])
  @@index([conferenceId, status])
  @@index([userId])
  @@index([registeredById])
  @@index([paymentProofFileId])
  @@map("conference_registrations")
}

/// A registered attendee may send one or more people to attend on their behalf.
model ConferenceRepresentative {
  id                           String   @id @default(cuid())
  conferenceId                 String
  principalRegistrationId      String
  principalUserId              String
  representativeRegistrationId String?
  representativeUserId         String
  notes                        String?  @db.Text
  createdById                  String?
  createdAt                    DateTime @default(now())

  conference                 Conference              @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  principalRegistration      ConferenceRegistration  @relation("PrincipalReps", fields: [principalRegistrationId], references: [id], onDelete: Cascade)
  representativeRegistration ConferenceRegistration? @relation("AsRepresentative", fields: [representativeRegistrationId], references: [id], onDelete: SetNull)
  principalUser              User                    @relation("RepresentedPrincipals", fields: [principalUserId], references: [id], onDelete: Cascade)
  representativeUser         User                    @relation("ActingRepresentatives", fields: [representativeUserId], references: [id], onDelete: Cascade)

  @@unique([conferenceId, principalUserId, representativeUserId])
  @@index([conferenceId, principalUserId])
  @@index([conferenceId, representativeUserId])
  @@map("conference_representatives")
}

model ConferenceAttendance {
  id           String   @id @default(cuid())
  conferenceId String
  userId       String
  dayDate      String   @db.VarChar(10)
  dayIndex     Int      @default(1)
  markedAt     DateTime @default(now())
  markedById   String?

  conference Conference @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  markedBy   User?      @relation("AttendanceMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)

  @@unique([conferenceId, userId, dayDate])
  @@index([conferenceId, dayDate])
  @@index([userId])
  @@index([markedById])
  @@map("conference_attendance")
}

model ConferenceCertificate {
  id                String   @id @default(cuid())
  certificateNumber String   @unique @db.VarChar(64)
  conferenceId      String
  userId            String
  recipientName     String
  attendancePercent Int
  daysAttended      Int
  totalDays         Int
  issuedAt          DateTime @default(now())
  downloadedAt      DateTime?
  emailedAt         DateTime?

  conference Conference @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conferenceId, userId])
  @@index([certificateNumber])
  @@index([conferenceId])
  @@map("conference_certificates")
}

model PaperSubmission {
  id                      String                @id @default(cuid())
  conferenceId            String
  userId                  String
  title                   String
  abstract                String?               @db.Text
  fileUrl                 String?
  fileId                  String?
  status                  PaperSubmissionStatus @default(DRAFT)
  improvementRequest      String?               @db.Text
  reviewNotes             String?               @db.Text
  reviewedAt              DateTime?
  reviewedById            String?
  assignedReviewerId      String?
  authorHasUnreadFeedback Boolean               @default(false)
  isFinalApproved         Boolean               @default(false)
  activityLog             Json?
  submittedAt             DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  conference       Conference @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedReviewer User?      @relation("PaperAssignedReviewer", fields: [assignedReviewerId], references: [id], onDelete: SetNull)

  @@index([conferenceId, status])
  @@index([userId])
  @@index([assignedReviewerId])
  @@index([reviewedById])
  @@index([fileId])
  @@map("paper_submissions")
}

model ConferenceFeedback {
  id           String   @id @default(cuid())
  conferenceId String
  userId       String
  /// DAY | SPEAKER
  feedbackType String   @default("DAY") @db.VarChar(16)
  /// dayDate (YYYY-MM-DD) or dayDate:speakerId
  targetKey    String   @default("overall") @db.VarChar(64)
  /// Compact answers: likert ratings / short comment
  answers      Json?
  rating       Int?
  comment      String?  @db.Text
  /// When true, admin views hide submitter identity
  isAnonymous  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  conference Conference @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conferenceId, userId, feedbackType, targetKey])
  @@index([conferenceId])
  @@index([userId])
  @@map("conference_feedback")
}

model ConferenceGiftIssuance {
  id           String   @id @default(cuid())
  conferenceId String
  /// user:<userId> or speaker:<speakerId>
  recipientKey String   @db.VarChar(80)
  /// participants | normal | keynote | guest | host | mc
  category     String   @db.VarChar(32)
  /// { [itemId]: quantityIssued }
  items        Json
  /// Optional admin note when issuing / adding a gift-only recipient
  comment      String?  @db.Text
  issuedAt     DateTime @default(now())
  issuedById   String?
  updatedAt    DateTime @updatedAt

  conference Conference @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  user       User?      @relation("GiftRecipient", fields: [userId], references: [id], onDelete: SetNull)
  userId     String?
  issuedBy   User?      @relation("GiftIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)

  @@unique([conferenceId, recipientKey, category])
  @@index([conferenceId])
  @@index([conferenceId, category])
  @@index([userId])
  @@index([issuedById])
  @@map("conference_gift_issuances")
}

/// Conference tour registration (separate from conference attendance registration).
model ConferenceTourRegistration {
  id             String   @id @default(cuid())
  conferenceId   String
  userId         String
  /// Amount paid (currency units, e.g. UGX). Required.
  amountPaid     Decimal  @db.Decimal(14, 2)
  organisation   String?
  notes          String?  @db.Text
  registeredAt   DateTime @default(now())
  registeredById String?
  updatedAt      DateTime @updatedAt

  conference   Conference @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  user         User       @relation("TourRegistrant", fields: [userId], references: [id], onDelete: Cascade)
  registeredBy User?      @relation("TourRegisteredBy", fields: [registeredById], references: [id], onDelete: SetNull)

  @@unique([conferenceId, userId])
  @@index([conferenceId])
  @@index([userId])
  @@index([registeredById])
  @@map("conference_tour_registrations")
}

model ConferenceResource {
  id           String                 @id @default(cuid())
  conferenceId String
  type         ConferenceResourceType
  title        String
  author       String?
  description  String?                @db.Text
  fileId       String
  fileName     String?
  sortOrder    Int                    @default(0)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  conference Conference @relation(fields: [conferenceId], references: [id], onDelete: Cascade)

  @@index([conferenceId, type])
  @@index([fileId])
  @@map("conference_resources")
}

model ConferencePresentation {
  id           String   @id @default(cuid())
  conferenceId String
  title        String
  speakerName  String?
  speakerTitle String?
  sessionLabel String?
  description  String?  @db.Text
  fileId       String?
  fileName     String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  conference Conference @relation(fields: [conferenceId], references: [id], onDelete: Cascade)

  @@index([conferenceId])
  @@index([fileId])
  @@map("conference_presentations")
}

/// Durable outbound email queue — processes in batches to avoid SMTP rate limits.
model EmailQueue {
  id           String    @id @default(cuid())
  /// Logical job group — all items from one bulk-send share a jobId
  jobId        String    @db.VarChar(64)
  /// Who queued it (denormalized for log integrity)
  actorId      String?
  actorEmail   String?   @db.VarChar(255)
  conferenceId String?
  /// Payload type — determines which service function handles the item
  type         String    @db.VarChar(64)
  /// Serialized payload (registrationId, conferenceId, etc.) — no raw passwords
  payload      Json
  status       String    @default("pending") @db.VarChar(16) // pending | sent | failed | skipped
  attempts     Int       @default(0)
  error        String?   @db.Text
  scheduledAt  DateTime  @default(now())
  processedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([status, scheduledAt])
  @@index([jobId])
  @@index([conferenceId])
  @@map("email_queue")
}

/// System-wide audit trail (visible to SUPERADMIN only)
model ActivityLog {
  id           String   @id @default(cuid())
  actorId      String?
  actorEmail   String?  @db.VarChar(255)
  actorName    String?  @db.VarChar(255)
  actorRole    String?  @db.VarChar(32)
  /// Machine key e.g. conference.create, registration.approve
  action       String   @db.VarChar(80)
  /// Human-readable summary
  description  String   @db.Text
  resourceType String?  @db.VarChar(64)
  resourceId   String?  @db.VarChar(80)
  conferenceId String?
  /// Optional structured details — never store secrets (passwords, access keys)
  metadata     Json?
  success      Boolean  @default(true)
  ipAddress    String?  @db.VarChar(45)
  userAgent    String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([actorId])
  @@index([conferenceId])
  @@index([resourceType, resourceId])
  @@map("activity_logs")
}
